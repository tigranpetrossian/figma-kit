{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["@testing-library/jest-dom"],
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "pretty": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@examples/*": ["./src/examples/*"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src", "test"]
}
