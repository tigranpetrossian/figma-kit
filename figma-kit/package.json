{
  "name": "figma-kit",
  "description": "A set of React components for building Figma plugins.",
  "homepage": "https://figma-kit.dev",
  "version": "0.0.0-semantic-release",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tigranpetrossian/figma-kit"
  },
  "keywords": [
    "react",
    "figma",
    "figma react components",
    "figma design system",
    "UI3",
    "component-library"
  ],
  "type": "module",
  "files": [
    "dist",
    "*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./figma-development-theme.css": "./dist/figma-development-theme.css",
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "pnpm build:js && pnpm build:css && pnpm build:figma-dev-theme-css && pnpm build:tailwind-css",
    "build:js": "vite build",
    "build:css": "postcss src/styles/index.css -o dist/styles.css",
    "build:figma-dev-theme-css": "postcss src/styles/figma-development-theme.css -o dist/figma-development-theme.css",
    "build:tailwind-css": "cp src/tailwind/tailwind.css dist/tailwind.css",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@emmetio/math-expression": "^1.0.5",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.2.0",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "merge-props": "6.0.0",
    "react-textarea-autosize": "8.5.9",
    "remeda": "2.34.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.5",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "4.3.0",
    "happy-dom": "20.9.0",
    "postcss": "8.5.15",
    "postcss-cli": "11.0.0",
    "postcss-import": "16.1.0",
    "postcss-nesting": "12.1.5",
    "typescript": "5.4.5",
    "vite": "5.4.21",
    "vite-plugin-dts": "3.9.1",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.6.1"
  }
}
