{
  "name": "figma-kit",
  "description": "A set of React components for building Figma plugins.",
  "homepage": "https://figma-kit.dev",
  "version": "0.0.0-semantic-release",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tigranpetrossian/figma-kit"
  },
  "keywords": [
    "react",
    "figma",
    "figma react components",
    "figma design system",
    "component-library"
  ],
  "type": "module",
  "files": [
    "dist",
    "*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./figma-development-theme.css": "./dist/figma-development-theme.css",
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./*": "./*"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "pnpm build:js && pnpm build:types && pnpm build:css && pnpm build:figma-dev-theme-css && pnpm build:tailwind-css",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:css": "postcss src/styles/index.css -o dist/styles.css",
    "build:figma-dev-theme-css": "postcss src/styles/figma-development-theme.css -o dist/figma-development-theme.css",
    "build:tailwind-css": "cp src/tailwind/tailwind.css dist/tailwind.css",
    "lint": "eslint \"**/{src,test}/**/*.{ts,tsx}\" --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@emmetio/math-expression": "^1.0.5",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.2.0",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle-group": "1.1.0",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "merge-props": "6.0.0",
    "react-textarea-autosize": "8.5.9",
    "remeda": "2.34.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "18.3.3",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/utils": "8.59.4",
    "@vitejs/plugin-react": "6.0.2",
    "conventional-changelog-conventionalcommits": "7.0.2",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "happy-dom": "20.9.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.5",
    "postcss": "8.5.15",
    "postcss-cli": "11.0.0",
    "postcss-import": "16.1.0",
    "postcss-nesting": "12.1.5",
    "postcss-prefixer": "3.0.0",
    "postcss-variables-prefixer": "1.2.0",
    "prettier": "3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-element-to-jsx-string": "15.0.0",
    "semantic-release": "25.0.2",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "**/{src,test}/**/*.{ts,tsx}": [
      "eslint --cache --fix --max-warnings 0",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.2.0",
  "pnpm": {
    "patchedDependencies": {
      "@radix-ui/react-slider@1.2.0": "patches/@radix-ui__react-slider@1.2.0.patch"
    }
  }
}
